#!/usr/bin/env bash

# Original idea: <https://github.com/epitron/scripts/blob/master/somafm>
# Modified and extended by Barret E <https://github.com/archusXIV>
#
# Dependencies: dialog, mpv, streamripper (optional).
# It is also provided as third party software in Mpv-Playlists-Manager.
# <https://github.com/archusXIV/mpv-playlists-manager>
#
# somabox let you play/rip chosen channels from <https://somafm.com/>
# Add/Remove items from their respective arrays and change the window size
# using lines and columns in the echo command below to correctly fit the amount
# of CHANNELS and stream informations at the bottom of the box.
# If streamripper is installed, don't forget to change the rip_dir variable.

for pkg in dialog mpv; do
    ! command -v "$pkg" && {
        notify-send -t 0 -u critical "$pkg isn't installed, exiting!"
        printf '%s\n' " $pkg isn't installed, exiting!"
        exit 127
    }
done

# Resize the window according to the amount of channels
# height = 29 lines, whidth = 96 columns
# Using wmctl with pixels if terminal does not support xterm protocols
if command -v wmctrl &> /dev/null; then
    wmctrl -r :ACTIVE: -e "5,-1,-1,980,660"
else
    echo -ne '\e[8;29;96t'
fi

# Globals
VERSION="v.0.9"
export MPVSOCKET="/tmp/mpvsocket"
soma_url="http://somafm.com/nossl/"
nowPlaying="NO STATION SELECTED"
nowRipping="$nowPlaying"
low=64 medium=130 high=256 higher=320

if command -v streamripper &> /dev/null; then
    rip_dir="$HOME/Documents/Music/streamripper"
    select="PLAY/RIP SELECTED"
else
    select="PLAY SELECTED"
fi

# Add/Remove channels here, one per line, using the format:
# "channel name|description|stream slug|low bitrate|high bitrate"
# Bitrate tokens must be one of: ${low}, ${medium}, ${high}, ${higher}.
CHANNELS_DATA=(
    "Boot Liquor|Americana Roots music|bootliquor|${medium}|${higher}"
    "Dark Zone|The darker side of deep ambient|darkzone|${medium}|${high}"
    "Deep Space One|Deep ambient electronic, experimental and space music|deepspaceone|${low}|${medium}"
    "Drone Zone|Served best chilled, safe with most medications|dronezone|${medium}|${high}"
    "Folk Forward|Indie Folk, Alt-folk and the occasional folk classics|folkfwd|${low}|${medium}"
    "Groove Salad|Nicely chilled plate of ambient/downtempo beats|gsclassic|${low}|${medium}"
    "Mission Control|Celebrating NASA and Space Explorers everywhere|missioncontrol|${low}|${medium}"
    "SF 10-33|Ambient tunes mixed with San Francisco public safety radio|sf1033|${low}|${medium}"
    "Space Station|Spaced-out ambient and mid-tempo electronica|spacestation|${low}|${medium}"
    "Synphaera Radio|Featuring the music from an independent record label|synphaera|${medium}|${high}"
    "ThistleRadio|Exploring music from Celtic roots and branches|thistle|${low}|${medium}"
    "Underground 80s|Early 80s UK Synthpop and a bit of New Wave|u80s|${medium}|${high}"
)

# Build the dialog menu list and both bitrate arrays from CHANNELS_DATA.
LIST=()
declare -A LOWBITRATES=()
declare -A HIGHBITRATES=()

for channel in "${CHANNELS_DATA[@]}"; do
    IFS='|' read -r name description slug low_br high_br <<< "$channel"
    LIST+=("$name" "$description")
    LOWBITRATES["$name"]="${soma_url}${slug}${low_br}.pls"
    HIGHBITRATES["$name"]="${soma_url}${slug}${high_br}.pls"
done

# keep this one empty to create a blank line between
# channels and tuned station quality informations.
LIST+=("" "")
unset IFS

_main() {
    while true; do

        channelChoice=$(
            dialog --stdout --backtitle "SOMABOX $VERSION" \
            --ok-label "$select" --cancel-label "QUIT SOMABOX" \
            --title "SOMAFM CHANNELS LIST" --no-shadow \
            --menu "Select a radio station:" 0 90 0 \
            "${LIST[@]}" \
            "NOW PLAYING:" "${nowPlaying}" \
            "" "${BITRATES_MSG}" \
            "NOW RIPPING:" "${nowRipping}" \
            "" "${RIPPING_MSG}"
        )

        case $? in 1) clear; _killProgram mpv streamripper; exit 0 ;; esac

        bitrates=$(
            dialog --stdout --backtitle "SOMABOX $VERSION" \
            --title "AUDIO BITRATES" \
            --menu "Select a bitrate for ${channelChoice}:" 10 50 2 \
            LOW  "(AAC 64k / MP3 128k)" \
            HIGH "(AAC 128k / MP3 256/320k)"
        )

        [[ $select == "PLAY/RIP SELECTED" && -n $bitrates ]] && {
            ripping=$(
                dialog --stdout --backtitle "SOMABOX $VERSION" \
                --title "STREAMRIPPER OPTIONS" \
                --menu "Do you want to record ${channelChoice}?" 10 50 2 \
                NO   "Play selected station instead" \
                YES  "Rip in selected quality"
            )
            [[ ! -d $rip_dir && $ripping == 'YES' ]] && mkdir --parents "$rip_dir"
        }

        if [[ $bitrates == 'LOW' && $ripping == 'YES' ]]; then
            nowRipping="${channelChoice}"
            RIPPING_MSG="Ripping in LOW quality: (AAC 64k / MP3 128k)"
            _ripChannel "${LOWBITRATES[${channelChoice}]}" &
        elif [[ $bitrates == 'HIGH' && $ripping == 'YES' ]]; then
            nowRipping="${channelChoice}"
            RIPPING_MSG="Ripping in HIGH quality: (AAC 128k / MP3 256/320k)"
            _ripChannel "${HIGHBITRATES[${channelChoice}]}" &
        elif [[ $bitrates == 'LOW' ]]; then
            nowPlaying="${channelChoice}"
            BITRATES_MSG="Playing in LOW quality: (AAC 64k / MP3 128k)"
            _playChannel "${LOWBITRATES[${channelChoice}]}"
        elif [[ $bitrates == 'HIGH' ]]; then
            nowPlaying="${channelChoice}"
            BITRATES_MSG="Playing in HIGH quality: (AAC 128k / MP3 256/320k)"
            _playChannel "${HIGHBITRATES[${channelChoice}]}"
        else
            continue
        fi

    done
}

_killProgram() {
    while (($# > 0)); do
        kill -SIGTERM "$(pgrep -x "$1")"
        shift
    done
    rm -rf "$rip_dir"/incomplete
} 2>/dev/null

_ripChannel() {
    _killProgram streamripper; sleep 0.2
    streamripper "$*" \
    -u "FreeAmp/2.x" \
    -d "$rip_dir" -s >/dev/null 2>&1
}

_playChannel() {
    _killProgram mpv; sleep 0.2
    mpv \
    --no-config \
    --idle=no \
    --cache=no \
    --no-terminal \
    --force-window=no \
    "${MPVSOCKET}" "$*" &
}

_main "${@}"

