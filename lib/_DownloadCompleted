#!/usr/bin/env bash
## This is a part of main script: mpm.

# shellcheck disable=SC2154
_DownloadCompleted() {

    cd "$playlists_dir" || exit 1

    clear

    # Backups made before a download task share the "_origin" suffix,
    # so we locate them instead of listing files one by one:
    # each backup is trashed along with its base file.
    local -a backups=(*_origin)
    local -a trash=(
        "$list" "$list_origin"
        "$titles_dir/$list.titles" "$titles_dir/$list.titles_origin"
        "$SELECTED_URLS1" "$SELECTED_URLS2"
        "$SELECTED_TITLES" "$SELECTED_TITLES"_origin
        "$tmp_dir/list_tmp" "$tmp_dir/list_tmp_origin"
    )
    local backup

    for backup in "${backups[@]}"; do
        # when no backup exists the glob remains literal
        [[ -e $backup ]] || continue
        trash+=("$backup" "${backup%_origin}")
    done

    [[ -f $tmp_dir/multipleFilesTitles_origin ]] && trash+=(
        "$tmp_dir/multipleFilesTitles_origin" "$tmp_dir/multipleFilesTitles"
        "$tmp_dir/loadMultiplePlaylists.m3u_origin" "$tmp_dir/loadMultiplePlaylists.m3u"
    )

    # files surviving when a non empty playlist is kept
    local -a kept_files=("$list" "$titles_dir/$list.titles")

    __removeTrash() {
        local file kept
        for file in "${trash[@]}"; do
            if [[ ${1:-} == "--keep" ]]; then
                for kept in "${kept_files[@]}"; do
                    [[ $file == "$kept" ]] && break
                done
            else
                rm -f "$file"
            fi
        done
    }

    if [[ $(_GetLinesList -l) -ne 0 || $(_GetLinesList -m) -ne 0 ]]; then
        # the playlist is not empty: it contains failed/undownloaded urls
        if [[ $keep_none_empty_playlist == yes ]]; then
            __removeTrash --keep
        else
            _BlankLine
            printf '%s\n' " ${critical}keep_none_empty_playlist is set to 'no'." \
            " ${info}Downloads are completed but ${list##*/} is not empty,"
            _Prompt " do you want to KEEP it?:${nc}" || {
                __removeTrash
                printf '%s\n' " ${critical}${list##*/} removed...${nc}"
                sleep 3
            }
            __removeTrash --keep
        fi
    else
        _BlankLine
        printf '%s\n' " ${info}Downloads completed." \
        " ${critical}${list##*/} is empty... ${list##*/} removed.${nc}"
        __removeTrash
        sleep 3
    fi

    _PolybarIpc
    _CheckParallelDownloads --after
    _IfQuitAfterTask -d

}

