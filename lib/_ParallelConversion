#!/usr/bin/env bash
## This is a part of main script: mpm.

# shellcheck disable=SC2154,SC2038,SC1083,SC2016
_ParallelConversion() {

    __parallelMethod() {
        printf '%s\n' " ${info}Parallel conversion enabled.${nc}"
        parallel --jobs "$parallel_threads" --bar \
        ffmpeg -hide_banner -loglevel quiet \
        -y -i {} -qscale:a 0 {.}."$1" ::: ./*.webm
    }

    __xargsMethod() {
        local -a webmFiles=()
        mapfile -t webmFiles < <(find "$mediaDir" -iname "*.webm")
        printf '%s\n' " ${info}use_parallel is set to no... using xargs.${nc}"
        # stripping the .webm suffix in a child shell so ffmpeg writes the final name directly
        printf '%s\0' "${webmFiles[@]}" | xargs -0 -I {} -P "$parallel_threads" \
            sh -c 'ffmpeg -hide_banner -loglevel quiet -y -i "$1" "${1%.webm}.$2"' _ {} "$1"
    }

    case "$1" in
        --parallel-default) __parallelMethod "$default_conversion_format" ;;
        --parallel-chosen ) __parallelMethod "${formats[${REPLY}]}" ;;
        --xargs-default   ) __xargsMethod "$default_conversion_format" ;;
        --xargs-chosen    ) __xargsMethod "${formats[${REPLY}]}" ;;
    esac

}
