#!/usr/bin/env bash
## This is a part of main script: mpm.

# shellcheck disable=SC2154
_ParallelDownloadCmd() {

    : "${parallel_audio_jobs:=6}"
    : "${parallel_video_jobs:=3}"

    local pid

    __cleanListsAndTitles() {
        if [[ $selectedList == 'true' ]]; then
            # we must preserve $SELECTED_URLS1 & $SELECTED_TITLES from being erased
            # because they are parsed in the _UpdateSelected function later on.
            :
        else
            sed -i '1,$d' {"$M3UFILE","$TITLES"}
            [[ $M3UFILE == "$DEFAULT_LIST" ]] && echo "#EXTM3U" > "$DEFAULT_LIST"
        fi
        rm -f {"$JOBSLIST","$tmp_dir"/parallel.log}
        clear
    }

    declare -a ytfmt=(
        "yt-dlp --format"
        "bestaudio"
        "bestvideo+bestaudio/best"
        "${ytdlPreset_MR[@]}"
    )

    __waitForPidToFinish() { pid=$!; wait "$pid"; }

    # Extract only the media URLs (lines starting with https) from a list file
    # into parallel's argument file. We do NOT build shell command lines here:
    # the URLs are passed to parallel as ARGUMENTS, and the yt-dlp command is
    # given once on parallel's own command line with {} as the placeholder.
    # GNU parallel then quotes each argument for the sub-shell, so characters
    # like & ? = ( ) in URLs can never be re-parsed as shell syntax.
    __makeArgFile() {
        # Args:
        #   $1: source list file (m3u)
        #   $2: destination argument file (one URL per line)
        while read -r line; do
            [[ $line =~ ^https ]] && printf '%s\n' "$line"
        done < "$1" > "$2"
    }

    # Build the yt-dlp argument set for audio or video as a global array that
    # the parallel command line will expand. Using arrays (not a flat string)
    # preserves each option as a single word for parallel to quote.
    __setDlArgs() {
        # Args:
        #   $1: 'audio' or 'video'
        if [[ $1 == audio ]]; then
            dlArgs=(--format "${ytfmt[1]}" "${ytdlPreset_NC[@]}")
        else
            if [[ ${ytdlPreset_MR[*]} ]]; then
                dlArgs=(--format "${ytdlPreset_MR[@]}" "${ytdlPreset_X[@]}")
            else
                dlArgs=(--format "${ytfmt[2]}" "${ytdlPreset_X[@]}")
            fi
        fi
    }

    case $1 in
        parallel)
            case "$2" in
                --choose-audio|--choose-video)
                    __makeArgFile "$M3UFILE" "$JOBSLIST"
                    if [[ $2 == "--choose-audio" ]]; then
                        __setDlArgs audio
                        Jobs="${parallel_audio_jobs}"
                    else
                        __setDlArgs video
                        Jobs="${parallel_video_jobs}"
                    fi
                    {
                        parallel \
                        --retries 2 \
                        --joblog "$tmp_dir"/parallel.log \
                        --jobs "${Jobs}" \
                        yt-dlp "${dlArgs[@]}" {} :::: "$JOBSLIST"
                        __waitForPidToFinish "$@"
                        __cleanListsAndTitles
                    } &
                ;;
                --get-audio|--get-video|--direct-video)
                    if [[ $2 == '--get-audio' ]]; then
                        [[ $M3UFILE != "$AUDIO_URLS" ]] && sed -i '1d' "$M3UFILE"
                        __setDlArgs audio
                        Jobs="${parallel_audio_jobs}"
                    else
                        [[ $M3UFILE != "$VIDEO_URLS" ]] && sed -i '1d' "$M3UFILE"
                        __setDlArgs video
                        Jobs="${parallel_video_jobs}"
                    fi
                    __makeArgFile "$M3UFILE" "$JOBSLIST"
                    {
                        parallel \
                        --retries 2 \
                        --joblog "$tmp_dir"/parallel.log \
                        --jobs "${Jobs}" \
                        yt-dlp "${dlArgs[@]}" {} :::: "$JOBSLIST"
                        __waitForPidToFinish "$@"
                        __cleanListsAndTitles
                    } &
                ;;
            esac
        ;;
        xargs)

            while read -r line; do
                [[ $line =~ ^https ]] && https+=("${line}")
            done < "${M3UFILE}"

            __getVideoResolution() {
                local res
                # Extract just the height number from ytdlPreset_MR
                res=$(echo "${ytdlPreset_MR[*]}" | grep -o '<=?[0-9]*')
                if [[ -z $res ]]; then
                    echo "<=?1080"  # Default to 1080p if not found
                else
                    echo "$res"
                fi
            }

            case $2 in
                --choose-audio|--get-audio)
                    printf '%s\n' "${https[@]}" \
                    | xargs -I '{}' -P "${parallel_audio_jobs}" \
                    yt-dlp --format "${ytfmt[1]}" "${ytdlPreset_NC[@]}" {}
                    __waitForPidToFinish "$@"
                    __cleanListsAndTitles
                ;;
                --choose-video|--direct-video|--get-video)
                    local maxHeight
                    maxHeight=$(__getVideoResolution)
                    printf '%s\n' "${https[@]}" \
                    | xargs -I '{}' -P "${parallel_video_jobs}" \
                    yt-dlp --format "bestvideo[height${maxHeight}][vcodec!=vp9]+bestaudio/best" \
                    "${ytdlPreset_X[@]}" {}
                    __waitForPidToFinish "$@"
                    __cleanListsAndTitles
                ;;
            esac

        ;;
    esac

} >/dev/null 2>&1
