#!/usr/bin/env bash
## This is a part of main script: mpm.

# shellcheck disable=SC2154
_IsMpmAlreadyRunning() {

    echo $$ >> "$MPM_PIDS"
    mapfile -t pids < "$MPM_PIDS"

    __killPids() {
        case "$1" in
            greaterThanOne)
                # kill mpm first instance
                kill -KILL "$(sed -n '1p' "$MPM_PIDS")"
                rm "$MPM_PIDS"
            ;;
            greaterThanTwo)
                rm "$MPM_PIDS"
                for ((i=0;i<=2;i++)); do
                    kill -KILL "${pids[${i}]}"
                done
            ;;
        esac
    }

    __killPrompt() {
        # If the received string is 'n' or 'enter' then relaunching mpm will be aborded,
        # if the received string is 'y' then we kill mpm.
        # Same thing if we've launched mpv from mpm.
        printf '\n%s\n' " ${critical}${0##*/} is already running..."
        _Prompt -n " Do you want to terminate ${0##*/}?${nc}" || return 1
    }

    # We only want ONE mpm running instance.
    if [[ -e $NOWPLAYING ]] && ((${#pids[@]} >= 3)); then
        # mpm is running, it also launched an mpv process
        # and the _WhileMpvIsRunning function which is in the background so we get
        # the right main menu options access.
        __killPrompt && {
            _Prompt -n \
            " ${critical}Mpv is also running, stop mpv?${nc}" && {
                _KillMpv && _RemoveMpvTmp
                __killPids greaterThanTwo
            }
            __killPids greaterThanTwo
        }
        sed -i '$d' "$MPM_PIDS" 2>/dev/null
        exit
    elif [[ ! -e $NOWPLAYING ]] && ((${#pids[@]} == 2)); then
        # A mpm instance is running and we're trying to launch another one.
        __killPrompt && __killPids greaterThanOne
        sed -i '$d' "$MPM_PIDS" 2>/dev/null
        exit
    fi

}
