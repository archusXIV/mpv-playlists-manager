#!/usr/bin/env bash
## This is a part of main script: mpm.

# shellcheck disable=SC2154
_RemoveDuplicateLines() {
    # Remove duplicate lines from a given file(s).
    # Some systems may use gawk or perl
    # we use '>= 1' and shift, so we can pass multiple arguments
    while (( $# >= 1 )); do
        awk -i inplace '!seen[$0]++ && !/^[[:space:]]*$/' "$1" || \
        perl -i -lne 'print if ! $a{$_}++ && ! /^\s*$/' "$1"
        shift
    done

}
