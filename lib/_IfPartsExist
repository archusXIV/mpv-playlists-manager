#!/usr/bin/env bash
## This is a part of main script: mpm.

# shellcheck disable=SC2154
_IfPartsExist() {

    cd "$mediaDir" || return

    # Wait for downloads to actually finish before checking for leftovers.
    # A fixed 'sleep 1' is a race: yt-dlp writes to .part/.temp files and
    # renames them to their final extension only at the very end of each job.
    # In progress-animation mode the loop exits as soon as the FILE COUNT
    # reaches the expected total, which can happen while other in-flight jobs
    # still have .part files being finalized. We therefore wait until no
    # yt-dlp process is running anymore.
    #
    # We must ALSO wait for ffmpeg: with '--merge-output-format mp4', yt-dlp
    # spawns ffmpeg to merge/mux the audio+video streams. ffmpeg is a SEPARATE
    # child process, so yt-dlp can be gone while ffmpeg is still writing the
    # final .mp4 and the partial streams still exist. Both must be idle before
    # we scan for leftovers. Bounded, so we never hang forever.
    local -i wait_cycles=0
    local -r max_wait_cycles=120  # ~120 x 0.5s = 60s safety cap
    while pgrep -x yt-dlp >/dev/null 2>&1 \
       || pgrep -x ffmpeg >/dev/null 2>&1; do
        sleep 0.5
        ((wait_cycles++))
        ((wait_cycles >= max_wait_cycles)) && break
    done

    mapfile -t parts < <(
        find . \
        -mindepth 1 \
        -maxdepth 1 \
        -name "*.part" \
        -o -name "*.temp.*"
    )

    declare -a pairs=(
        "$AUDIO_URLS:$AUDIO_TITLES"
        "$VIDEO_URLS:$VIDEO_TITLES"
        "$DEFAULT_LIST:$DEFAULT_TITLES"
        "$SELECTED_URLS1:$SELECTED_TITLES"
        "$playlists_dir/$list:$titles_dir/$list.titles"
        "$playlists_dir/loadMultiplePlaylists.m3u:$titles_dir/loadMultiplePlaylists.m3u.titles"
    )

    if ((${#parts[@]} > 0)); then

        for pair in "${pairs[@]}"; do
            IFS=':'; read -r urls titles <<< "$pair"
            local origin="${urls}_origin"
            if [[ -f $origin ]]; then
                mv --force "$origin" "$urls"
                mv --force "${titles}_origin" "$titles"
                break
            fi
        done

        clear
        echo -e "\n ${critical}Incomplete file(s) detected:${nc}\n"
        printf '%s\n' "${parts[@]##*/}" | sort -d | nl
        _BlankLine
        printf '%s\n' " ${critical}${#urls[@]} file(s) from ${M3UFILE##*/} failed to download," \
        " ${M3UFILE##*/} has been preserved, try again later.${nc}"
        unset IFS urls
        read -rsn 1 -p " ${info}Press any key to continue...${nc}"

        clear
        _PolybarIpc
        _CheckParallelDownloads --after
        return 1

    fi

}
